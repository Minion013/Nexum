{
  "name": "pactflow-testnet-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test",
    "test:smoke": "node --test test/server.test.mjs",
    "test:rules": "node --test test/agreement-engine.test.mjs",
    "typecheck": "node --check src/server.mjs && node --check src/agreement-engine.mjs && node --check public/app.js",
    "contracts:check": "solcjs --optimize --base-path . --include-path . --bin --abi --output-dir .scratch/solc-output contracts/EscrowVault.sol contracts/EscrowVaultFactory.sol"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ethers": "^6.17.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.30"
  }
}
