# Required to start the PactFlow web application. This publishable key is the
# only Supabase credential sent to the browser.
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional until the Base Sepolia reader is implemented. It is never exposed
# to browser code by the web server.
BASE_SEPOLIA_RPC_URL=

# Do not add Supabase secret/service keys, wallet private keys, or deployment
# credentials to this file or browser code.
