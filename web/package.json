{
  "name": "pactflow-testnet-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "start": "npm run build && node src/server.mjs",
    "test": "node --test",
    "test:smoke": "node --test test/server.test.mjs",
    "typecheck": "node --check src/server.mjs && node --check public/home.js && node --check public/login.js",
    "contracts:check": "solcjs --optimize --base-path .. --include-path .. --bin --abi --output-dir ../.scratch/solc-output ../contracts/EscrowVault.sol ../contracts/EscrowVaultFactory.sol"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "ethers": "^6.17.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.30"
  },
  "dependencies": {
    "@privy-io/js-sdk-core": "^0.69.0",
    "@privy-io/node": "^0.28.0",
    "@supabase/supabase-js": "^2.112.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.8"
  }
}
